# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: Public base URL of the application (used for canonical URLs & sitemap).
APP_URL=

# Public Supabase Configuration (safe for client bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public Cloudinary Cloud Name (safe for client bundle)
VITE_CLOUDINARY_CLOUD_NAME=

# Public Meta Pixel ID
VITE_META_PIXEL_ID=

# Private Server-Side Secrets (NEVER prefix with VITE_ or commit to Git)
SUPABASE_SECRET_KEY=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
